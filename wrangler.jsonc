{
  // Hornada — forma C: assets estáticos + Worker + D1
  "name": "hornada",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hornada",
      "database_id": "71c4a6d4-1346-40ab-9883-a6aecf8eb9bb"
    }
  ]
}
